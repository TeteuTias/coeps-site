{
  "name": "coeps-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:payments": "node --experimental-strip-types --test \"app/lib/payments/__tests__/*.test.ts\"",
    "test:payments:integration": "node --experimental-strip-types --test --test-concurrency=1 \"app/lib/payments/__tests__/integration/*.test.ts\"",
    "migrate:payment-codes": "node scripts/migrations/setup-payment-codes.mjs",
    "migrate:payment-indexes": "node scripts/migrations/setup-payment-indexes.mjs",
    "payment:credentials": "node scripts/payments/derive-payment-credentials.mjs"
  },
  "dependencies": {
    "@auth0/nextjs-auth0": "^4.22.0",
    "@types/lodash": "^4.17.20",
    "@vercel/blob": "^2.3.3",
    "aws-sdk": "^1.18.0",
    "bson": "^6.10.4",
    "dompurify": "^3.2.7",
    "file-type": "^21.0.0",
    "framer-motion": "^12.23.6",
    "html2pdf.js": "^0.14.0",
    "jsdom": "^27.0.0",
    "lodash": "^4.17.21",
    "lucide-react": "^0.525.0",
    "luxon": "^3.4.4",
    "mongodb": "^6.8.0",
    "next": "16.2.7",
    "pagarme": "^4.35.2",
    "qrcode": "^1.5.4",
    "react": "^18",
    "react-canvas-confetti": "^2.0.7",
    "react-credit-cards-2": "^1.0.2",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/node": "^24.0.10",
    "@types/react": "^19.1.8",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.2.7",
    "mongodb-memory-server": "11.2.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.8.3"
  }
}
